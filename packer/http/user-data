#cloud-config
autoinstall:
  version: 1
  locale: en_US.UTF-8
  keyboard:
    layout: us
  storage:
    layout:
      name: lvm
  identity:
    hostname: ar-base
    username: vagrant
    password: "$6$rounds=4096$saltsalt$hash"  # vagrant - sostituire con hash reale
  ssh:
    install-server: true
    allow-pw: true
  packages:
    - python3
    - python3-apt
    - openssh-server
    - open-vm-tools
  late-commands:
    - echo 'vagrant ALL=(ALL) NOPASSWD:ALL' > /target/etc/sudoers.d/vagrant
    - chmod 0440 /target/etc/sudoers.d/vagrant
